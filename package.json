{
  "name": "huawei-territorial-dashboard-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "data:build:endutih": "python3 scripts/build_endutih_2024.py",
    "data:report:endutih": "python3 scripts/build_data_quality_report.py",
    "data:build:all": "python3 scripts/build_endutih_2024.py && python3 scripts/build_data_quality_report.py",
    "data:build:analytics": "python3 scripts/build_municipal_analytics.py && python3 scripts/export_municipal_from_analytics.py",
    "data:export:municipal": "python3 scripts/export_municipal_from_analytics.py",
    "data:recluster": "python3 scripts/recluster_municipal.py",
    "data:enrich:rf": "python3 scripts/enrich_rf_diagnostics.py",
    "data:build:context": "python3 scripts/etl/build_context_variables.py",
    "data:build:geojson": "python3 scripts/etl/build_geojson.py",
    "data:combine": "python3 scripts/combine_data.py",
    "data:import": "python3 scripts/import_variable.py",
    "data:layer1": "python3 scripts/analytics/layer1_descriptive.py",
    "data:layer1:municipal": "python3 scripts/analytics/layer1_municipal.py",
    "data:pipeline": "python3 scripts/combine_data.py && python3 scripts/analytics/layer1_descriptive.py",
    "data:build:temporal": "python scripts/analytics/build_temporal_outputs.py",
    "data:build:pca": "python scripts/analytics/pca.py"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-simple-maps": "^3.0.0",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
